{
    "name": "hugo-tania",
    "version": "3.0.0",
    "private": true,
    "packageManager": "pnpm@11.24.0",
    "description": "A Hugo theme for readable blogs",
    "repository": {
        "type": "git",
        "url": "https://github.com/fordes123/hugo-tania",
        "original": "https://github.com/WingLim/hugo-tania"
    },
    "author": "fordes123 <github@fordes123.dev>",
    "license": "MIT",
    "scripts": {
        "dev": "hugo server --source exampleSite",
        "build": "hugo --source exampleSite --minify --templateMetrics --templateMetricsHints",
        "typecheck": "tsc --noEmit",
        "format": "prettier assets/ts assets/css --write",
        "format:check": "prettier assets/ts assets/css --check",
        "update:modules": "hugo mod get -u ./..."
    },
    "devDependencies": {
        "prettier": "3.10.1",
        "typescript": "5.9.3"
    }
}
